MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/?retryWrites=true&w=majority

# --- Option A: Anthropic API directly ---
ANTHROPIC_API_KEY=sk-ant-...

# --- Option B: OpenRouter (takes priority over Option A when set) ---
# WRASSE_BASE_URL=https://openrouter.ai/api
# WRASSE_AUTH_TOKEN=sk-or-...
# Model names as listed on openrouter.ai/models (Sonnet 5 and Haiku 4.5):
# WRASSE_MODEL=anthropic/...
# WRASSE_TRIAGE_MODEL=anthropic/...

# Optional: WRASSE_DB=mock runs against in-memory mongomock (tests / offline dev; nothing is saved)
